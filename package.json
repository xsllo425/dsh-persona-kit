{
  "name": "dsh-persona-kit",
  "version": "0.1.0",
  "description": "Roles that feel like someone, for DeepSeek Harness: role switching, a 1-5 intensity slider, role-bound stickers, relationship tracks, rebirth, achievements, avatars, grey suggestions. 中英双语。",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "runtime": "host",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "files": [
    "lib",
    "defaults",
    "examples",
    "presets",
    "tools",
    "cordis.patch.yml",
    "README.md",
    "CONTRIBUTORS.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "persona",
    "roleplay",
    "stickers"
  ],
  "author": {
    "name": "xsllo",
    "url": "https://github.com/xsllo425"
  },
  "homepage": "https://github.com/xsllo425/dsh-persona-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsllo425/dsh-persona-kit.git"
  },
  "bugs": {
    "url": "https://github.com/xsllo425/dsh-persona-kit/issues"
  }
}
